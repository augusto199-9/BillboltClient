# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the service settings instead.

# Simple pieces from Supabase (Project Settings → Database → Connect) —
# paste each one exactly as Supabase shows it, no encoding needed even if
# the password has $ or other symbols. `npm run prepare-env` (runs
# automatically as part of the Render build) assembles these into the
# DATABASE_URL / DIRECT_URL that Prisma needs, encoding correctly for you.
SUPABASE_HOST="aws-0-us-east-2.pooler.supabase.com"
SUPABASE_USER="postgres.<project-ref>"
SUPABASE_PASSWORD="<your-database-password>"
# SUPABASE_DATABASE="postgres"   # only needed if it's not "postgres"

# Advanced / alternative: set these directly instead of the SUPABASE_*
# pieces above, if you'd rather assemble the connection strings yourself.
# If both are set, they take priority and prepare-env.js does nothing.
# DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Your frontend's URL(s), comma-separated if more than one. Example:
# CORS_ORIGIN="https://billbolt-frontend.onrender.com,https://billing.yourclient.com"
CORS_ORIGIN="*"

PORT=3001

# ── Push notifications ──────────────────────────────────────────────
# Generate your OWN pair (don't reuse example values from a README/chat):
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Secret so only your own scheduler can trigger the daily reminder check
# over HTTP (POST /api/push/run-daily-check with header X-Cron-Secret).
# Generate one the same way as JWT_SECRET.
CRON_SECRET="replace-with-a-long-random-string"

# Set to "false" to disable the built-in in-process daily timer (e.g. if
# you're triggering reminders externally instead — see backend/README.md).
ENABLE_IN_PROCESS_CRON="true"
# Cron expression, in UTC. Default: 13:00 UTC daily.
REMINDER_CRON="0 13 * * *"

